{
  "manifest_version": 3,
  "name": "Deteksi Judi Online .ac.id",
  "version": "3.0.0",
  "description": "Memeriksa halaman website berdomain .ac.id dan memberi tahu pengguna apakah halaman tersebut berisi konten judi online (lampu hijau, kuning, atau merah).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deteksi Judi Online .ac.id",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ac.id/*",
        "*://ac.id/*"
      ],
      "js": [
        "lexicon.js",
        "scanner.js",
        "ringkas.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.ac.id/*",
    "*://ac.id/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}