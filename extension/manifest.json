{
  "manifest_version": 3,
  "name": "Deteksi Judi Online .ac.id",
  "version": "2.0.0",
  "description": "Mendeteksi konten judi online tersembunyi pada website berdomain .ac.id memakai model Random Forest/LightGBM lokal, lengkap dengan penanda bukti di halaman.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deteksi Judi Online .ac.id",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.ac.id/*", "*://ac.id/*"],
      "js": ["lexicon.js", "scanner.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.ac.id/*",
    "*://ac.id/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
